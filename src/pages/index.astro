---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import avatar from "@/assets/avatar.png";
import Layout from "@/layout/base.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const years = Object.entries(
  Object.groupBy(posts, (p) => p.data.date.getFullYear()),
).sort(([a], [b]) => Number(b) - Number(a));
---

<Layout>
  <Image
    src={avatar}
    alt="Vasyl Polishchuk"
    width={100}
    height={100}
    quality={95}
    loading="eager"
    class="size-8 shadow-md rounded-full object-cover object-top"
  />
  <header class="mt-8">
    <h1 class="font-[450]">Vasyl Polishchuk</h1>
    <p class="text-muted">Frontend engineer</p>
  </header>
  <div class="mt-8 space-y-4">
    <p class="text-balance">
      Currently at <a
        target="_blank"
        rel="noreferrer"
        href="https://volvetech.com"
        ><span
          aria-hidden="true"
          class="relative before:absolute before:inset-0 before:bg-current before:[mask:url(/volve.svg)_left_center/0.8em_no-repeat]"
          >&emsp;</span
        >Volve</a
      >, where <span class="text-muted">I&nbsp;lead frontend engineering</span>,
      building AI tools that help construction teams win the right work.
    </p>
    <p>
      Previously, I&nbsp;built the web for land buyers at <a
        target="_blank"
        rel="noreferrer"
        href="https://spartagrounds.com">Sparta Grounds</a
      > and freelanced on <a
        target="_blank"
        rel="noreferrer"
        href="https://www.upwork.com/freelancers/~015c1b113a62e11b13">Upwork</a
      >, <span class="text-muted">shipping 40+ websites and apps</span> with a
      100% Job Success score, including
      sites for <a
        target="_blank"
        rel="noreferrer"
        href="https://417recovery.com">417 Recovery</a
      > and <a
        target="_blank"
        rel="noreferrer"
        href="https://volunteersforukraine.org">Volunteers for Ukraine</a
      >.
    </p>
    <p>
      You can find me on <a
        target="_blank"
        rel="noreferrer"
        href="https://github.com/vasyaqwe">GitHub</a
      > and <a
        target="_blank"
        rel="noreferrer"
        href="https://www.linkedin.com/in/vasyl-polishchuk-37329624b"
        >LinkedIn</a
      >, or reach me via <a href="mailto:vasyl@vasyaqwe.com">email</a>.
    </p>
  </div>
  <section class="mt-16">
    <h2 class="pb-3 text-muted">Writing</h2>
    {
      years.map(([year, posts]) => (
        <div class="grid grid-cols-[5rem_1fr] border-t">
          <span class="py-3 text-muted tabular-nums">{year}</span>
          <ul>
            {posts?.map((post) => (
              <li class="not-first:border-t">
                <a
                  href={`/blog/${post.id}`}
                  class="plain flex justify-between gap-4 py-3 hover:text-muted"
                >
                  <span class="line-clamp-1">{post.data.title}</span>
                  <span class="shrink-0 text-muted tabular-nums">
                    {post.data.date.toLocaleDateString("en-GB", {
                      day: "2-digit",
                      month: "2-digit",
                      timeZone: "UTC",
                    })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Layout>
